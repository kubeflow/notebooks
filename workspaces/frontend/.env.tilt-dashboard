# Tilt, with the Kubeflow dashboard enabled (ENABLE_DASHBOARD=true).
#
# Loaded instead of `.env.tilt` via `npm run start:tilt-dashboard`, so this file
# must be self-contained: dotenv only loads `.env.${DEV_ENV}`, not both.
APP_ENV=development

DEPLOYMENT_MODE=kubeflow
MOCK_API_ENABLED=false

# Must stay empty. While MANDATORY_NAMESPACE is set, mod-arch-core pins the
# namespace to it and never registers the centraldashboard `onNamespaceSelected`
# handler, so switching namespace in the dashboard has no effect on the frontend.
MANDATORY_NAMESPACE=

PUBLIC_PATH=/workspaces/

# Server configuration - use port 8080 to match deployment manifest
PORT=8080

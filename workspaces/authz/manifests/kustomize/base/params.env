# The issuer MUST be the same one the Kubernetes API server is configured with,
# otherwise the usernames this service authorizes with will not match the
# usernames in your RoleBindings.
OIDC_ISSUER_URL=https://dex.example.com/dex
OIDC_CLIENT_ID=kubeflow-workspaces
OIDC_REDIRECT_URL=https://kubeflow.example.com/oauth2/callback

# These MUST match the API server's --oidc-username-claim, --oidc-username-prefix,
# --oidc-groups-claim and --oidc-groups-prefix.
OIDC_USERNAME_CLAIM=email
OIDC_USERNAME_PREFIX=
OIDC_GROUPS_CLAIM=groups
OIDC_GROUPS_PREFIX=

# Points controller-generated workspace HTTPRoutes at the backend's external
# authorization endpoint using the ExternalAuth filter (GEP-1494).
#
# Without this, workspace routes reach a notebook pod with no authentication in
# front of them, so the gateway-api overlay alone is only safe on a trusted
# network.
#
# The backend answers the check on /authz with the same SubjectAccessReview
# machinery that gates its own handlers; no additional component is deployed.
# Injecting the caller's identity is the job of whatever OIDC layer fronts the
# gateway, such as oauth2-proxy.
#
# Requires:
#   - the Gateway API *experimental* channel CRDs, as ExternalAuth is an
#     Extended, experimental feature
#   - a Gateway implementation that supports the ExternalAuth filter
EXTERNAL_AUTH_BACKEND_NAME=workspaces-backend
EXTERNAL_AUTH_BACKEND_NAMESPACE=kubeflow-workspaces
EXTERNAL_AUTH_BACKEND_PORT=4000
EXTERNAL_AUTH_PROTOCOL=HTTP
EXTERNAL_AUTH_HTTP_PATH=/authz

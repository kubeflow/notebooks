# Publishing workspaces through a Gateway is a configuration of the one
# deployment, not a separate mode: a full Kubeflow distribution and a
# standalone install use this same component and differ only in these values.
#
# Setting GATEWAY_NAME is what selects Gateway API routing.
GATEWAY_NAME=kubeflow/kubeflow-gateway
GATEWAY_HOSTS=*
CLUSTER_DOMAIN=cluster.local

# Workspace routes are proxied straight to a notebook pod, so every route
# carries an ExternalAuth filter (GEP-1494) pointing at this service; the
# backend answers the check on /authz with the same SubjectAccessReview
# machinery that gates its own handlers. Injecting the caller's identity is the
# job of whatever OIDC layer fronts the gateway, such as oauth2-proxy.
#
# Requires the Gateway API *experimental* channel CRDs (ExternalAuth is an
# Extended, experimental feature), a Gateway implementation that supports the
# filter, and a ReferenceGrant in the service's namespace (see
# reference-grant.yaml). Empty this out only on a network where reaching a
# workspace pod already implies authorization.
EXTERNAL_AUTH_URL=http://workspaces-backend.kubeflow-workspaces:4000/authz

# Restricts ingress to workspace pods to the Gateway's own pods, as
# "namespace" or "namespace:key=value,...". Without this, any pod in the
# cluster can bypass the gateway — and its ExternalAuth filter — by connecting
# to a workspace Service directly. The selector must match the pods of the
# Gateway named in GATEWAY_NAME.
WORKSPACE_NETWORK_POLICY_INGRESS=kubeflow:gateway.networking.k8s.io/gateway-name=kubeflow-gateway

# The controller's own pods, admitted alongside the gateway: the Jupyter
# activity probe connects to the workspace pod directly, and culling stalls
# if the policy blocks it. Must match the namespace and labels of the
# workspaces-controller Deployment.
WORKSPACE_NETWORK_POLICY_SELF=kubeflow-workspaces:app=workspaces-controller


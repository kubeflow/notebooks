# Restricts ingress to workspace pods to the routing layer.
#
# Workspace pods serve an unauthenticated notebook. Without this, any pod in the
# cluster can reach them directly on their Service, bypassing the gateway and
# whatever authentication runs there — including another tenant's workspace,
# which by definition runs user-supplied code.
#
# In an Istio deployment this is covered by the per-namespace AuthorizationPolicy
# that the Kubeflow Profile controller creates. There is no equivalent otherwise.
#
# The selector must match the pods of the Gateway named in GATEWAY_NAME. Leave
# WORKSPACE_NETWORK_POLICY_INGRESS_POD_SELECTOR empty to allow the whole ingress
# namespace instead.
WORKSPACE_NETWORK_POLICY=true
WORKSPACE_NETWORK_POLICY_INGRESS_NAMESPACE=kubeflow
WORKSPACE_NETWORK_POLICY_INGRESS_POD_SELECTOR=gateway.networking.k8s.io/gateway-name=kubeflow-gateway

# Disable analytics
analytics_settings(False)

# Enforce minimum Tilt version
version_settings(check_updates=True, constraint=">=0.33.0")

# Increase timeout for k8s operations
update_settings(k8s_upsert_timeout_secs=120)

# Allow kind-tilt context (set up by Makefile before tilt runs)
allow_k8s_contexts('kind-tilt')

# Allow skipping frontend via environment variable
enable_frontend = os.getenv("ENABLE_FRONTEND", "true").lower() == "true"

# Allow skipping the dashboard setup via environment variable
enable_dashboard = os.getenv("ENABLE_DASHBOARD", "true").lower() == "true"

if enable_dashboard and not enable_frontend:
    fail(msg="Setting 'ENABLE_DASHBOARD' requires 'ENABLE_FRONTEND', exiting!")

# Allow enabling Prometheus for metrics verification via environment variable
enable_prometheus = os.getenv("ENABLE_PROMETHEUS", "false").lower() == "true"

# Get paths relative to Tiltfile location
# Tilt evaluates paths relative to the Tiltfile directory
tilt_root = os.path.dirname(os.path.abspath(__file__))

# Go up 1 level from Tiltfile location: developing -> repo root
workspace_root = os.path.dirname(tilt_root)

# Define paths relative to workspace root
controller_dir = os.path.join(workspace_root, "workspaces/controller")
backend_dir = os.path.join(workspace_root, "workspaces/backend")
frontend_dir = os.path.join(workspace_root, "workspaces/frontend")

# Kustomize binary path (installed by Makefile)
kustomize_bin = os.path.join(tilt_root, "bin/kustomize")


# ============================================================================
# Helpers
# ============================================================================

# Workload kinds: each becomes its own Tilt resource automatically.
WORKLOAD_KINDS = [
    "Deployment",
    "StatefulSet",
    "DaemonSet",
    "ReplicaSet",
    "ReplicationController",
    "Job",
    "CronJob",
    "Pod",
]

# Kinds that Tilt assigns to their own resources automatically, so they must
# never be listed in a k8s_resource(objects=...) call:
#   - Workloads (Deployment/StatefulSet/...) each become their own Tilt resource.
#   - A Service is folded into the workload resource its selector targets.
# Listing any of these in objects= makes Tilt fail the Tiltfile with
# "No object identified by the fragment ... could be found in remaining YAML",
# because the object was already claimed by its workload resource.
TILT_AUTO_MANAGED_KINDS = WORKLOAD_KINDS + ["Service"]

# Returns the names of every workload object in a rendered manifest, so the
# resources Tilt auto-creates for them can be grouped/labeled without hardcoding
# names that could drift when the upstream manifests are bumped.
def workload_names(manifest):
    names = []
    for o in decode_yaml_stream(manifest):
        if o.get("kind") in WORKLOAD_KINDS:
            name = o.get("metadata", {}).get("name")
            if name:
                names.append(name)
    return names

# Builds the Tilt object refs ("name:kind" or "name:kind:namespace") for every
# object in a rendered manifest, so a whole kustomize target can be grouped into
# a single k8s_resource without hardcoding its contents here.
def object_refs(manifest, exclude_kinds=[]):
    refs = []
    for o in decode_yaml_stream(manifest):
        kind = o.get("kind")
        name = o.get("metadata", {}).get("name")
        if not kind or not name:
            continue

        if kind in exclude_kinds:
            continue

        if kind == "Namespace":
            continue

        # Skip kinds Tilt manages via workload resources (see above).
        if kind in TILT_AUTO_MANAGED_KINDS:
            continue

        namespace = o.get("metadata", {}).get("namespace")
        if namespace:
            refs.append("%s:%s:%s" % (name, kind.lower(), namespace))
        else:
            refs.append("%s:%s" % (name, kind.lower()))
    return refs


# ============================================================================
# Kubernetes Cluster
# ============================================================================

# Note: Kind cluster and cert-manager are set up by the Makefile before Tilt starts

# ============================================================================
# Controller
# ============================================================================

# We use the production Dockerfile for controller.
docker_build(
    "ghcr.io/kubeflow/notebooks/workspaces-controller",
    dockerfile=os.path.join(controller_dir, "Dockerfile"),
    context=controller_dir,
)

# Build manifests with kustomize
if enable_prometheus:
    controller_kustomize_path = os.path.join(controller_dir, "manifests/kustomize/overlays/istio-prometheus")
else:
    controller_kustomize_path = os.path.join(controller_dir, "manifests/kustomize/overlays/istio")
controller_manifests = kustomize(controller_kustomize_path, kustomize_bin=kustomize_bin)

# Apply manifests
k8s_yaml(controller_manifests, allow_duplicates=True)

# Manage k8s_yaml resources
# - Attach to the auto-created controller workload resource (so the port-forwards
#   bind to a real pod) and fold in the controller's non-workload objects.
# - Port-forward controller for local access
k8s_resource(
    workload="workspaces-controller",
    new_name="workspaces-controller-group",
    objects=object_refs(controller_manifests),
    port_forwards=[
      "8080:8080", # healthz
      "8081:8081", # metrics
    ],
    labels=["controller"],
)


# ============================================================================
# Backend
# ============================================================================

# We use the production Dockerfile for backend.
# NOTE: Production Dockerfile expects 'workspaces/' as context
docker_build(
    "ghcr.io/kubeflow/notebooks/workspaces-backend",
    dockerfile=os.path.join(backend_dir, "Dockerfile"),
    context=os.path.dirname(backend_dir),
)

# Build manifests with kustomize
backend_kustomize_path = os.path.join(backend_dir, "manifests/kustomize/overlays/istio")
backend_manifests = kustomize(backend_kustomize_path, kustomize_bin=kustomize_bin)

# Mutate the manifest objects before applying
backend_objects = decode_yaml_stream(backend_manifests)
for o in backend_objects:
    kind = o.get("kind")
    name = o.get("metadata", {}).get("name")
    if not kind or not name:
        continue

    if kind == "Deployment" and name == "workspaces-backend":
        containers = o.get("spec", {}).get("template", {}).get("spec", {}).get("containers", {})
        env = containers[0].get("env", {})
        tilt_env_vars = {
            "SWAGGER_ENABLED": "true",
            "SWAGGER_SCHEME": "https",
            "SWAGGER_HOST": "localhost:8443",
            "SWAGGER_BASE_PATH": "/workspaces/api/v1",
        }

        # Replace existing keys and add missing ones
        for (i, var) in enumerate(env):
            key = var["name"]
            if key in tilt_env_vars.keys():
                env[i] = {
                    "name": key,
                    "value": tilt_env_vars[key],
                }
                tilt_env_vars.pop(key)

        for (key, value) in tilt_env_vars.items():
            env.append({
                "name": key,
                "value": value,
            })

backend_manifests_modified = encode_yaml_stream(backend_objects)

k8s_yaml(backend_manifests_modified, allow_duplicates=True)

# Manage k8s_yaml resources
# - Attach to the auto-created backend workload resource and fold in its objects
# - Resource dependencies on controller
k8s_resource(
    workload="workspaces-backend",
    objects=object_refs(backend_manifests_modified),
    resource_deps=["workspaces-controller-group"],
    labels=["backend"],
)


# ============================================================================
# Frontend (optional)
# ============================================================================

if enable_frontend:

    # We use a development Dockerfile for frontend as the production Dockerfile
    # does not include dev dependencies like node.js and webpack.
    docker_build(
        "ghcr.io/kubeflow/notebooks/workspaces-frontend",
        dockerfile=os.path.join(frontend_dir, "Dockerfile.dev"),
        context=frontend_dir,
        live_update=[
            # Sync source files into the container
            # Changes to these files trigger webpack HMR without container restart
            sync(os.path.join(frontend_dir, "src"), "/app/src"),
            sync(os.path.join(frontend_dir, "config"), "/app/config"),

            # If package.json or package-lock.json changes, reinstall dependencies
            # This ensures new packages are available without a full rebuild
            run(
                "cd /app && npm install",
                trigger=[
                    os.path.join(frontend_dir, "package.json"),
                    os.path.join(frontend_dir, "package-lock.json"),
                ],
            ),
        ],
        # Ignore files that shouldn't trigger rebuilds
        ignore=[
            os.path.join(frontend_dir, "node_modules"),
            os.path.join(frontend_dir, "dist"),
            os.path.join(frontend_dir, "coverage"),
            os.path.join(frontend_dir, "*.md"),
        ],
    )

    # Build manifests with kustomize
    frontend_kustomize_path = os.path.join(frontend_dir, "manifests/kustomize/overlays/istio")
    frontend_manifests = kustomize(frontend_kustomize_path, kustomize_bin=kustomize_bin)

    # Mutate the manifest objects before applying
    frontend_objects = decode_yaml_stream(frontend_manifests)
    for o in frontend_objects:
        # skip if missing kind/name
        kind = o.get("kind")
        name = o.get("metadata", {}).get("name")
        if not kind or not name:
            continue

        # Remove the VirtualService URI rewrite for dev
        # In production, a static file server serves assets regardless of path prefix,
        # so the rewrite from /workspaces/ to / is fine. But webpack dev server uses
        # publicPath to determine serving paths, so it needs requests to arrive with
        # the /workspaces/ prefix intact.
        if kind == "VirtualService" and name == "workspaces-frontend":
            for http_route in o.get("spec", {}).get("http", []):
                http_route.pop("rewrite", None)

        # modify the frontend deployment for dev
        if kind == "Deployment" and name == "workspaces-frontend":
            containers = o.get("spec", {}).get("template", {}).get("spec", {}).get("containers", [])
            for container in containers:
                if container.get("name") == "workspaces-frontend":
                    # Increase memory limits for webpack dev server
                    # Production uses 512Mi but webpack compilation needs much more
                    container["resources"] = {
                        "limits": {
                            "cpu": "2",
                            "memory": "4Gi",
                        },
                        "requests": {
                            "cpu": "500m",
                            "memory": "3Gi",
                        },
                    }

                    # Add startup probe for webpack dev server
                    # Webpack needs time to compile the bundle before serving requests
                    # Startup probe allows up to 5 minutes (30 * 10s) for initial compilation
                    # Once startup probe passes, liveness/readiness probes take over
                    container["startupProbe"] = {
                        "httpGet": {
                            "path": "/workspaces/",
                            "port": 8080,
                            "scheme": "HTTP",
                        },
                        "initialDelaySeconds": 10,
                        "periodSeconds": 10,
                        "timeoutSeconds": 5,
                        "failureThreshold": 30,
                    }

                    # Set the container command depending on whether the dashboard is enabled or not.
                    if enable_dashboard:
                        container["command"] = ["npm", "run", "start:tilt-dashboard"]
                    else:
                        container["command"] = ["npm", "run", "start:tilt"]

    # Apply modified manifests
    frontend_manifests_modified = encode_yaml_stream(frontend_objects)
    k8s_yaml(frontend_manifests_modified, allow_duplicates=True)

    # Manage k8s_yaml resources
    # - Attach to the auto-created frontend workload resource and fold in its objects
    # - Resource dependencies on backend
    k8s_resource(
        workload="workspaces-frontend",
        objects=object_refs(frontend_manifests_modified),
        resource_deps=["workspaces-backend"],
        labels=["frontend"],
    )


# ============================================================================
# Istio Gateway Resources
# ============================================================================
# Apply the gateway namespace, TLS certificate, and Istio Gateway resources.
# These are prerequisites for the VirtualServices created by backend/frontend overlays.
# Note: Istio itself (istiod, ingress gateway) is installed by the Makefile before Tilt starts.

istio_gateway_path = os.path.join(tilt_root, "manifests/istio-gateway")
istio_gateway_manifest = kustomize(istio_gateway_path, kustomize_bin=kustomize_bin)
k8s_yaml(istio_gateway_manifest, allow_duplicates=True)

# Manage k8s_yaml resources
# - Apply Tilt-specific grouping/labels
k8s_resource(
    objects=object_refs(istio_gateway_manifest),
    new_name="istio-gateway",
    labels=["istio"],
)

# Port-forward the Istio ingress gateway for local access to production-like routing.
# Uses local_resource because the ingress gateway is installed by istioctl (not managed by Tilt),
# and extra_pod_selectors doesn't support port-forwarding on object-only resources.
gateway_links = [link("https://localhost:8443/workspaces/api/v1/swagger/index.html", "API (Backend)")]
if enable_frontend:
    gateway_links.insert(0, link("https://localhost:8443/workspaces/", "Frontend"))
if enable_dashboard:
    gateway_links.insert(0, link("https://localhost:8443/", "Dashboard"))

frontend_resource_deps = ["istio-gateway", "workspaces-backend"]
if enable_frontend:
    frontend_resource_deps.append("workspaces-frontend")
if enable_dashboard:
    frontend_resource_deps.append("kubeflow-dashboard")

local_resource(
    "istio-ingressgateway",
    serve_cmd="kubectl port-forward -n istio-system svc/istio-ingressgateway 8443:443",
    resource_deps=frontend_resource_deps,
    links=gateway_links,
    labels=["istio"],
)

# ============================================================================
# Dashboard
# ============================================================================

if enable_dashboard:
    dashboard_kustomize_path = os.path.join(tilt_root, "manifests/kubeflow-dashboard")
    dashboard_manifests = kustomize(dashboard_kustomize_path, kustomize_bin=kustomize_bin)
    k8s_yaml(dashboard_manifests, allow_duplicates=True)

    # Manage k8s_yaml resources
    # - Group the dashboard's non-workload objects under a single resource.
    k8s_resource(
        objects=object_refs(dashboard_manifests),
        new_name="kubeflow-dashboard",
        labels=["kubeflow-dashboard"],
    )

    # Tilt auto-creates a resource for each workload in the dashboard manifest
    # (the dashboard, the profile-controller, and the poddefaults webhook). Label
    # them so they stay grouped with the dashboard in the Tilt UI.
    for dashboard_workload in workload_names(dashboard_manifests):
        k8s_resource(
            workload=dashboard_workload,
            labels=["kubeflow-dashboard"],
        )

    local_resource(
        "profile-crd-established",
        cmd="kubectl wait --for=condition=established crd/profiles.kubeflow.org --timeout=60s",
        resource_deps=["kubeflow-dashboard"],
        labels=["kubeflow-dashboard"],
    )

# ============================================================================
# Profiles
# ============================================================================

if enable_dashboard:
    profiles_kustomize_path = os.path.join(tilt_root, "manifests/profiles")
    profiles_manifest = kustomize(profiles_kustomize_path, kustomize_bin=kustomize_bin)
    k8s_yaml(profiles_manifest)

    k8s_resource(
        objects=object_refs(profiles_manifest),
        new_name="profiles",
        resource_deps=["profile-crd-established"],
        labels=["kubeflow-dashboard"],
    )

    # The profile-controller creates one Namespace per Profile, named after the
    # Profile itself, so the Profile names are also the namespace names.
    profile_namespaces = [
        o["metadata"]["name"]
        for o in decode_yaml_stream(profiles_manifest)
        if o.get("kind") == "Profile" and o.get("metadata", {}).get("name")
    ]
    if not profile_namespaces:
        fail(msg="No Profile resources rendered from %s, exiting!" % profiles_kustomize_path)

    # Profile namespaces are created asynchronously by the profile-controller
    # reconciling the Profile CRs, so explicitly wait for every namespace to
    # exist before applying namespaced objects into them -- depending on the
    # "profiles" resource alone only guarantees the Profile CRs were submitted,
    # not that the controller has reconciled them into actual Namespaces yet.
    local_resource(
        "profile-namespaces-ready",
        cmd=" && ".join([
            "kubectl wait --for=create namespace/%s --timeout=120s" % ns
            for ns in profile_namespaces
        ]),
        resource_deps=["profiles"],
        labels=["kubeflow-dashboard"],
    )


# ============================================================================
# Prometheus (optional)
# ============================================================================

#
# TODO: apply the prometheus manifests (operator and instance prometheus) in tilt rather
#       than applying it with `setup-prometheus.sh` in the Makefile.
#
if enable_prometheus:
    local_resource(
        "prometheus-ui",
        serve_cmd="kubectl port-forward -n monitoring svc/prometheus-operated 9090:9090",
        resource_deps=["workspaces-controller-group"],
        links=[link("http://localhost:9090", "Prometheus UI")],
        labels=["prometheus"],
    )



# ============================================================================
# Dev Resources
# ============================================================================

dev_resources_deps = ["workspaces-controller-group"]
if enable_dashboard:
    dev_resources_path = os.path.join(tilt_root, "manifests/dev-resources-dashboard")
    dev_resources_deps.append("profile-namespaces-ready")
else:
    dev_resources_path = os.path.join(tilt_root, "manifests/dev-resources-standalone")

dev_resources_manifest = kustomize(dev_resources_path, kustomize_bin=kustomize_bin)
k8s_yaml(dev_resources_manifest, allow_duplicates=True)

k8s_resource(
    objects=object_refs(dev_resources_manifest),
    new_name="dev-resources",
    resource_deps=dev_resources_deps,
    labels=["dev"],
)

# Optional, persistent settings for `make tilt-up` / `make tilt-down`.
#
# Copy this file to `tilt.env` (gitignored) and uncomment the options you want:
#
#   cp tilt.env.example tilt.env
#
# Values set on the command line (`make tilt-up VAR=x`) or in the environment
# (`VAR=x make tilt-up`) take precedence over this file.
# Run `make show-config` to see the effective values and where they came from.
#
# NOTE: this file is included by make:
#   - use `?=` (not `=`), otherwise the file overrides values from the environment
#   - do not quote values, quotes are kept literally

# Deploy the frontend webpack dev server (requires ~3 GiB of memory)
#ENABLE_FRONTEND ?= true

# Deploy the Kubeflow Dashboard (requires ENABLE_FRONTEND=true)
#ENABLE_DASHBOARD ?= true

# Install Prometheus for metrics verification
#ENABLE_PROMETHEUS ?= false

# Install metrics-server for `kubectl top` verification
#ENABLE_METRICS_SERVER ?= false

# Use an alternative container runtime for kind (e.g., podman)
#KIND_EXPERIMENTAL_PROVIDER ?= podman
